<div class="intro">
  <h1 class="hye-title">
    <strong>MaVitrineDuWeb Le Blog</strong> <br />Sites Web
    <br />personnalisés<br />
    A <strong>La Rochelle</strong> .
  </h1>
  <h2 class="intro__heading-2" data-text="LE BLOG">LE BLOG</h2>
  <p class="presenting">
    <span class="collapsed">
      Ce blog est dédié à la <strong>Création de sites web</strong>
      <strong>à moindre coût</strong> et
      <strong>sans compromis sur la qualité</strong>. <br />Pour ceux qui
      souhaitent découvrir comment créer un
      <strong>site internet professionnel</strong> presque
      <strong>gratuit</strong> en privilégiant des
      <strong>solutions open source</strong>.
    </span>
    <span class="full-text" style="display: none">
      Ce blog est dédié à la <strong>Création de sites web</strong>
      <strong>à moindre coût</strong> et
      <strong>sans compromis sur la qualité</strong>. <br />Pour ceux qui
      souhaitent découvrir comment créer un
      <strong>site internet professionnel</strong> presque
      <strong>gratuit</strong> en privilégiant des
      <strong>solutions open source</strong>. <br /><br />Nous explorons ces
      solutions pour la conception de <strong>sites web autonomes</strong>, des
      alternatives aux CMS payants, et des outils open source performants pour
      développer des
      <strong>sites e-commerce, sites vitrine, ou blogs</strong> sans avoir à
      payer d'abonnement.
      <strong>Suivez-nous pour des conseils</strong> pratiques, des comparatifs,
      et des études de cas sur la création de sites web performants et sécurisés
      avec des technologies <strong>open source</strong>.
    </span>
  </p>
  <div class="read-actions">
    <a href="#" class="read-more">... Lire la suite</a>
    <a href="#" class="read-less" style="display: none">... Réduire</a>
  </div>
</div>
<picture>
  <!-- À partir de 601 px : version desktop -->
  <source
    id="blog-banner-desktop"
    media="(min-width: 601px)"
    type="image/webp"
    srcset="/img/accueil-blog/banner-blog-mvdw-claire.webp"
    data-light="/img/accueil-blog/banner-blog-mvdw-claire.webp"
    data-dark="/img/accueil-blog/banner-blog-mvdw-dark.webp"
  />

  <!-- Par défaut : version mobile -->
  <img
    id="blog-banner"
    src="/img/accueil-blog/banner-blog-mvdw-mobile-claire.webp"
    data-light="/img/accueil-blog/banner-blog-mvdw-mobile-claire.webp"
    data-dark="/img/accueil-blog/banner-blog-mvdw-mobile-dark.webp"
    alt="Illustration maritime du blog MaVitrineDuWeb à La Rochelle"
    class="hero-image"
    loading="lazy"
    decoding="async"
  />
</picture>

<section class="articles">
  <h2 class="articles__heading">DERNIERS POSTS :</h2>
  <!-- blog section -->
  <div class="blogs-section">
    <% data.forEach(post => { %>
    <div class="blog-card">
      <div class="card-image-wrapper">
        <picture>
          <source
            srcset="<%= post.bannerImages.smallImgConvert %>"
            type="image/webp"
          />

          <img
            src="<%= post.bannerImages.smallImgBase %>"
            class="blog-image-card"
            alt="<%= post.title %>"
            width="350"
            height="150"
            loading="lazy"
          />
        </picture>
      </div>
      <div class="card-content-wrapper">
        <% const postDate = getPostDateDisplay(post); %>
        <h3
          class="card-title<%= post.title.length > 56 ? ' card-title--long' : '' %>"
        >
          <%= post.title %>
        </h3>
        <p class="card-text"><%- post.description %></p>
        <a href="/blog/post/<%= post.slug || post._id %>" class="btn dark"
          >read</a
        >
        <span class="card-article-list__date"
          ><%= postDate.formattedDate %></span
        >
      </div>
    </div>
    <% }) %>
  </div>
  <!-- prettier-ignore -->
  <div class="pagination">
      <% for (let i = 1; i <= Math.ceil(count / perPage); i++) { %> 
        <% if (i == current) { %>
          <a href="" class="pagination__current"><%= i %></a>
        <% } else { %>
          <a href="/blog/?page=<%= i %>" class="pagination__link"><%= i %></a>
        <% } %> 
      <% } %>
    </div>
</section>
