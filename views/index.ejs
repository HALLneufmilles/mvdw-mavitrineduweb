<!-- 'index.ejs' est le fichier rendu dans le composant 'body' de 'main.ejs'. -->
<!-- <div class="main"> -->

<div class="intro">
  <div class="intro__layout">
    <h1 class="hye-title">
      <strong class="hye-title__eyebrow">MaVitrineDuWeb Le Blog</strong>
      <span class="hye-title__main"
        >Sites Web<br />personnalisés<br />A
        <strong>La Rochelle</strong> .</span
      >
    </h1>
    <span class="intro__divider" aria-hidden="true"></span>
    <div class="intro__copy">
      <p class="presenting">
        <span class="collapsed">
          Ce blog est dédié à la <strong>Création de sites web</strong>
          <strong>à moindre coût</strong> et
          <strong>sans compromis sur la qualité</strong>. <br />Pour ceux qui
          souhaitent découvrir comment créer un
          <strong>site internet professionnel</strong> presque
          <strong>gratuit</strong> en privilégiant des
          <strong>solutions open source</strong>.
        </span>
        <span class="full-text" style="display: none">
          Ce blog est dédié à la <strong>Création de sites web</strong>
          <strong>à moindre coût</strong> et
          <strong>sans compromis sur la qualité</strong>. <br />Pour ceux qui
          souhaitent découvrir comment créer un
          <strong>site internet professionnel</strong> presque
          <strong>gratuit</strong> en privilégiant des
          <strong>solutions open source</strong>. <br /><br />Nous explorons ces
          solutions pour la conception de <strong>sites web autonomes</strong>,
          des alternatives aux CMS payants, et des outils open source
          performants pour développer des
          <strong>sites e-commerce, sites vitrine, ou blogs</strong> sans avoir
          à payer d'abonnement.
          <strong>Suivez-nous pour des conseils</strong> pratiques, des
          comparatifs, et des études de cas sur la création de sites web
          performants et sécurisés avec des technologies
          <strong>open source</strong>.
        </span>
      </p>
      <div class="read-actions">
        <a href="#" class="read-more">... Lire la suite</a>
        <a href="#" class="read-less" style="display: none">... Réduire</a>
      </div>
    </div>
  </div>
</div>
<div class="blog-hero">
  <picture class="blog-hero__picture">
    <!-- À partir de 601 px : version desktop -->
    <source
      id="blog-banner-desktop"
      media="(min-width: 601px)"
      type="image/webp"
      srcset="/img/accueil-blog/banner-blog-mvdw-claire.webp"
      data-light="/img/accueil-blog/banner-blog-mvdw-claire.webp"
      data-dark="/img/accueil-blog/banner-blog-mvdw-dark.webp"
    />

    <!-- Par défaut : version mobile -->
    <img
      id="blog-banner"
      src="/img/accueil-blog/banner-blog-mvdw-mobile-claire.webp"
      data-light="/img/accueil-blog/banner-blog-mvdw-mobile-claire.webp"
      data-dark="/img/accueil-blog/banner-blog-mvdw-mobile-dark.webp"
      alt="Illustration maritime du blog MaVitrineDuWeb à La Rochelle"
      class="hero-image"
      loading="lazy"
      decoding="async"
    />
  </picture>

  <div class="blog-hero__branding">
    <h2 class="intro__heading-2" data-text="LE BLOG">
      <span class="blog-hero__light-word">LE</span>
      <strong class="blog-hero__strong-word">BLOG</strong>
    </h2>
    <div class="blog-hero__brand-row">
      <span class="blog-hero__line" aria-hidden="true"></span>
      <p class="blog-hero__initials">
        <span>M</span><span>V</span><span>D</span><span>W</span>
      </p>
      <span class="blog-hero__line" aria-hidden="true"></span>
    </div>
    <p class="blog-hero__brand-name">MA VITRINE DU WEB</p>
  </div>
</div>

<section class="articles">
  <h2 class="articles__heading">DERNIERS POSTS :</h2>
  <!-- blog section -->
  <div class="blogs-section">
    <% data.forEach(post => { %>
    <div class="blog-card">
      <div class="card-image-wrapper">
        <picture>
          <source
            srcset="<%= post.bannerImages.smallImgConvert %>"
            type="image/webp"
          />

          <img
            src="<%= post.bannerImages.smallImgBase %>"
            class="blog-image-card"
            alt="<%= post.title %>"
            width="350"
            height="150"
            loading="lazy"
          />
        </picture>
      </div>
      <div class="card-content-wrapper">
        <% const postDate = getPostDateDisplay(post); %>
        <h3
          class="card-title<%= post.title.length > 56 ? ' card-title--long' : '' %>"
        >
          <%= post.title %>
        </h3>
        <p class="card-text"><%- post.description %></p>
        <a href="/blog/post/<%= post.slug || post._id %>" class="btn dark"
          >read</a
        >
        <span class="card-article-list__date"
          ><%= postDate.formattedDate %></span
        >
      </div>
    </div>
    <% }) %>
  </div>
  <!-- prettier-ignore -->
  <div class="pagination">
      <% for (let i = 1; i <= Math.ceil(count / perPage); i++) { %> 
        <% if (i == current) { %>
          <a href="" class="pagination__current"><%= i %></a>
        <% } else { %>
          <a href="/blog/?page=<%= i %>" class="pagination__link"><%= i %></a>
        <% } %> 
      <% } %>
    </div>
</section>
